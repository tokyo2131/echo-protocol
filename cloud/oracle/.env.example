# Copy to cloud/oracle/.env and fill in before running create-instance-retry.sh.
# Assumes `oci setup config` has already been run once, interactively,
# to generate ~/.oci/config and an API signing key — that step needs a
# human at a keyboard and can't be scripted safely, so it's not
# automated here. See docs/ORACLE-FREE-TIER.md.

# oci iam compartment list  (or use your tenancy OCID for the root compartment)
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..xxxxxxxx

# oci iam availability-domain list --compartment-id "$OCI_COMPARTMENT_ID"
# Space-separated; the retry script cycles through all of them each pass.
# Single-AD regions (most non-US regions) will only have one.
OCI_AVAILABILITY_DOMAINS="AbCd:US-ASHBURN-AD-1 AbCd:US-ASHBURN-AD-2 AbCd:US-ASHBURN-AD-3"

# oci network subnet list --compartment-id "$OCI_COMPARTMENT_ID"
# A public subnet, so the instance gets a public IP.
OCI_SUBNET_ID=ocid1.subnet.oc1..xxxxxxxx

# oci compute image list --compartment-id "$OCI_COMPARTMENT_ID" \
#   --operating-system Debian --shape VM.Standard.A1.Flex
# If Debian isn't listed as a platform image for your tenancy/region,
# see docs/ORACLE-FREE-TIER.md for the fallback (custom image import).
OCI_IMAGE_ID=ocid1.image.oc1..xxxxxxxx

OCI_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub
OCI_INSTANCE_NAME=echo-protocol-server

# Full Always Free Ampere A1 allocation, as one instance. Reduce if you'd
# rather split the free 4 OCPU / 24GB across multiple smaller instances.
OCI_OCPUS=4
OCI_MEMORY_GB=24
# Always Free block storage cap is 200GB total (boot + any extra volumes).
OCI_BOOT_VOLUME_GB=100

# How long to wait between retry passes across all availability domains.
OCI_RETRY_INTERVAL_SECONDS=60
# 0 = retry forever until it succeeds or you Ctrl-C.
OCI_MAX_ATTEMPTS=0
