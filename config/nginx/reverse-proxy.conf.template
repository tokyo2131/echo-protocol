# Managed by echo-protocol scripts/12-nginx-certbot.sh
# Template for a reverse-proxy vhost in front of a Dockerized app.
# Copy to /etc/nginx/sites-available/<name>.conf, replace the
# __PLACEHOLDERS__, symlink into sites-enabled, then run:
#   certbot --nginx -d __DOMAIN__
#
# Deliberately HTTP-only as rendered — proxies straight to the upstream,
# not a redirect, so the site actually works before a certificate
# exists. Certbot's nginx plugin adds the HTTPS server block itself
# (with its own certificate paths, modern TLS defaults, and dhparams —
# see /etc/letsencrypt/options-ssl-nginx.conf) once issuance succeeds,
# and rewrites this HTTP block to redirect to it when run with
# --redirect (which scripts/12-nginx-certbot.sh does). Writing a
# `listen 443 ssl` block here ourselves before a cert exists is invalid
# config — nginx refuses to start at all, for every vhost, not just
# this one — so don't add one back in.

upstream __NAME___upstream {
    # Port the container/service publishes on 127.0.0.1 (see
    # docker/docker-compose.example.yml "ports" mapping).
    server 127.0.0.1:__UPSTREAM_PORT__;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Certbot's HTTP-01 challenge.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    client_max_body_size 25m;

    access_log /var/log/nginx/__NAME__.access.log;
    error_log  /var/log/nginx/__NAME__.error.log;

    location / {
        proxy_pass http://__NAME___upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
