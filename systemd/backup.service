# Managed by echo-protocol scripts/16-automation-cron.sh
# __ADMIN_USER__ is substituted with the real admin username at install time.
[Unit]
Description=echo-protocol daily backup run
Wants=network-online.target
After=network-online.target docker.service postgresql.service redis-server.service

[Service]
Type=oneshot
ExecStart=/home/__ADMIN_USER__/scripts/automation/backup-run.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
