# Managed by echo-protocol scripts/12-nginx-certbot.sh
# Template for a reverse-proxy vhost in front of a Dockerized app.
# Copy to /etc/nginx/sites-available/<name>.conf, replace the
# __PLACEHOLDERS__, symlink into sites-enabled, then run:
#   certbot --nginx -d __DOMAIN__
# which rewrites the server block in place to add the TLS listener.

upstream __NAME___upstream {
    # Port the container/service publishes on 127.0.0.1 (see
    # docker/docker-compose.example.yml "ports" mapping).
    server 127.0.0.1:__UPSTREAM_PORT__;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Certbot's HTTP-01 challenge; also a permanent redirect once TLS is on.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    # Certbot fills in ssl_certificate / ssl_certificate_key here.
    include /etc/nginx/snippets/ssl-params.conf;

    client_max_body_size 25m;

    access_log /var/log/nginx/__NAME__.access.log;
    error_log  /var/log/nginx/__NAME__.error.log;

    location / {
        proxy_pass http://__NAME___upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
