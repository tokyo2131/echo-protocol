# Copy this file to .env and edit before running install.sh
# `set -a; source .env; set +a` is done automatically by install.sh.

# --- Admin account created by scripts/00-bootstrap.sh ---
ADMIN_USER=deploy
# Public Ed25519 key installed into the admin user's authorized_keys.
# Generate locally with: ssh-keygen -t ed25519 -C "you@yourhost"
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA... you@yourhost"

# --- SSH ---
SSH_PORT=22

# --- Git identity (scripts/15-git-config.sh) ---
GIT_USER_NAME="Deploy Bot"
GIT_USER_EMAIL=deploy@example.com

# --- Nginx / Certbot (scripts/12-nginx-certbot.sh) ---
PRIMARY_DOMAIN=example.com
CERTBOT_EMAIL=admin@example.com

# Second reverse-proxy slot reserved for the Ruflo project.
RUFLO_DOMAIN=ruflo.example.com

# Third reverse-proxy slot reserved for the mcp-claude MCP server
# (github.com/tokyo2131/mcp-claude). Purpose still undecided as of
# provisioning time — see that repo's README.
MCP_CLAUDE_DOMAIN=mcp-claude.example.com

# --- PostgreSQL (scripts/11-databases.sh) ---
POSTGRES_APP_DB=appdb
POSTGRES_APP_USER=appuser
POSTGRES_APP_PASSWORD=change-me-generate-with-openssl-rand-base64-32

# --- Redis ---
REDIS_PASSWORD=change-me-generate-with-openssl-rand-base64-32

# --- Backups (automation/backup-run.sh) ---
BACKUP_ROOT=/home/${ADMIN_USER}/backups
BACKUP_RETENTION_DAYS=14
# Optional: rclone remote (e.g. a DigitalOcean Spaces bucket) to push
# encrypted backup archives to off-server storage. Leave empty to keep
# backups local-only.
BACKUP_OFFSITE_RCLONE_REMOTE=

# --- Notifications (automation/health-check.sh) ---
# Optional webhook (Slack/Discord-compatible) for health-check alerts.
HEALTH_CHECK_WEBHOOK_URL=
